[Unit]
Description=Cache for Linux
After=network-online.target
Wants=network-online.target

[Service]
User=cache
Group=cache
ExecStart=/opt/cache-app/current/cache serve --data /var/lib/cache-app --web /opt/cache-app/current/web --helper /opt/cache-app/current/helper/cache-core-helper --core-lib /opt/cache-app/current/lib/libcache_search.so
Restart=always
RestartSec=5
StateDirectory=cache-app
StateDirectoryMode=0750
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
