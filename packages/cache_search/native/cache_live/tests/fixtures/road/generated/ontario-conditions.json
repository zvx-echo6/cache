{
  "format": 1,
  "id": "road511-511on-ca-conditions",
  "title": "Ontario 511 winter road conditions",
  "provider": "Ontario 511",
  "description": "statewide Ontario winter road conditions from 511 by road section; the same list for every place; needs a 511 developer key",
  "attribution": "Road condition data from Ontario 511 (511on.ca); use is subject to the 511 developer terms",
  "request": {
    "url": "https://511on.ca/api/v3/get/roadconditions?key={api_key}&format=json"
  },
  "api_key": {
    "alias": "road511.511on.ca",
    "required": true
  },
  "refresh_minutes": 15,
  "quota": {
    "per_minute": 4,
    "per_day": 400,
    "per_month": 8000
  },
  "validity": {
    "fixed_hours": 3
  },
  "require": [
    "[0]"
  ],
  "items": [
    {
      "each": "^",
      "key": {
        "first_of": [
          {
            "path": "Id"
          },
          {
            "path": "ID"
          },
          {
            "template": "{road}: {loc}",
            "vars": {
              "road": {
                "path": "RoadwayName"
              },
              "loc": {
                "path": "LocationDescription"
              }
            }
          },
          {
            "template": "{area}: {loc}",
            "vars": {
              "area": {
                "path": "AreaName"
              },
              "loc": {
                "path": "LocationDescription"
              }
            }
          }
        ]
      },
      "label": {
        "first_of": [
          {
            "template": "{road}: {loc}",
            "vars": {
              "road": {
                "path": "RoadwayName"
              },
              "loc": {
                "path": "LocationDescription"
              }
            }
          },
          {
            "template": "{area}: {loc}",
            "vars": {
              "area": {
                "path": "AreaName"
              },
              "loc": {
                "path": "LocationDescription"
              }
            }
          },
          {
            "path": "LocationDescription"
          }
        ]
      },
      "time": {
        "path": "LastUpdated",
        "time": {
          "in": "unix",
          "out": "datetime"
        }
      },
      "fields": [
        {
          "label": "Overall status",
          "first_of": [
            {
              "path": "OverallStatus"
            },
            {
              "path": "Overall Status"
            }
          ]
        },
        {
          "label": "Weather",
          "first_of": [
            {
              "path": "WeatherConditions"
            },
            {
              "path": "Weather Conditions"
            }
          ]
        },
        {
          "label": "Special conditions",
          "first_of": [
            {
              "path": "SpecialConditions"
            },
            {
              "path": "Special Conditions"
            }
          ]
        },
        {
          "label": "Condition",
          "path": "Condition"
        },
        {
          "label": "Visibility",
          "path": "Visibility"
        },
        {
          "label": "Area",
          "path": "AreaName"
        },
        {
          "label": "Details",
          "path": "Description",
          "max_chars": 300
        },
        {
          "label": "Updated",
          "path": "LastUpdated",
          "time": {
            "in": "unix",
            "zone": "place",
            "out": "%Y-%m-%d %H:%M"
          }
        }
      ]
    }
  ]
}
