          "type": [
            "string",
            "null"
          ]
        },
        "delimiter": {
          "description": "One character; default \",\" for csv and a tab for tsv.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "header": {
          "description": "The first row names the columns (default true). Without it the columns are `c0`, `c1`, ...",
          "default": null,
          "type": [
            "boolean",
            "null"
          ]
        },
        "skip_after_header": {
          "description": "Rows to drop after the header (the type row of a tab-separated RDB file).",
          "default": 0,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "TimeSpec": {
      "type": "object",
      "required": [
        "in"
      ],
      "properties": {
        "assume": {
          "description": "With \"pattern\" and no offset in it: \"place\" (default) or \"utc\".",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "in": {
          "description": "How the response writes the time: \"local\" (no offset, in the place's offset: `2026-10-25T14:00` or a date), \"utc\" (no offset, in UTC: `2026-10-26 05:17:56.783` or `...Z`), \"rfc3339\" (with an offset), \"rfc2822\", \"unix\" (seconds), \"unix_ms\" (milliseconds) or \"pattern\" (see `pattern`).",
          "type": "string"
        },
        "not_before": {
          "description": "A date (`2000-01-01`) before which a time is missing: providers write year 0001 or 1970 for \"no time\".",
