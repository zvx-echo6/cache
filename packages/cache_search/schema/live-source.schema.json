          "format": "double"
        },
        "not_covered_after": {
          "description": "With `end_path`: also report `not_covered_after` (the date of the end).",
          "default": false,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "XmlDef": {
      "type": "object",
      "properties": {
        "always_array": {
