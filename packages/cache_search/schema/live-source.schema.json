          "type": [
            "string",
            "null"
          ]
        },
        "out": {
          "description": "\"datetime\" (`2026-10-25T14:00-06:00`, default), \"datetime_s\" (with seconds), \"date\", or a strftime pattern.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "pattern": {
          "description": "With \"pattern\": a strftime pattern the text follows (`%d/%m/%Y %H:%M`). With `%z` it has an offset; without, it is read in `assume`.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "zone": {
          "description": "\"place\": write it in the place's offset even when the response gave another. Default: keep the response's.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
