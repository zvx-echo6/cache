        "param": {
          "description": "The value of a user parameter.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "prefix": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
